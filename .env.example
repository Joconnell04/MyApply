# Copy to .env and fill with real values

# Security & Sessions
SECRET_KEY=change-me-generate-with-python-secrets
SESSION_COOKIE_NAME=app_session
SESSION_SECURE=auto
SESSION_SAMESITE=lax

# Database
DATABASE_URL=sqlite:///./myapply.db

# Environment
ENV=development
PORT=8000

# OpenAI API Key - Required for LLM features and AgentKit workflows
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o-mini
COVER_LETTER_MODEL=gpt-4o

# MyApply API Key (optional, for internal AgentKit tool services)
MYAPPLY_API_KEY=dev_key

# Mapbox Tokens (optional, for map features)
MAPBOX_PUBLIC_TOKEN=pk.your-public-token
MAPBOX_ACCESS_TOKEN=pk.your-access-token

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000
